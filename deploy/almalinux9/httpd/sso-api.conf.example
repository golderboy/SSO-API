# Internal backend only. Public HTTPS traffic is proxied from the existing
# port 443 virtual host by using sso-api-proxy.inc.example.
Listen 127.0.0.1:8089

<VirtualHost 127.0.0.1:8089>
    ServerName sobmoeiservice.moph.go.th
    DocumentRoot /var/www/sso-api/public

    LimitRequestBody 65536
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    <Directory /var/www/sso-api/public>
        AllowOverride None
        Options -Indexes +FollowSymLinks
        Require all granted

        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^ index.php [L]
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php-fpm/www.sock|fcgi://localhost"
    </FilesMatch>

    <LocationMatch "^/(?!\.well-known/)\.">
        Require all denied
    </LocationMatch>

    ErrorLog logs/sso-api-error.log
    CustomLog logs/sso-api-access.log combined
</VirtualHost>
