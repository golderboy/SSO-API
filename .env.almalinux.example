APP_NAME="Sobmoei SSO API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sobmoeiservice.moph.go.th/call

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sso
DB_USERNAME=sso_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/call
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Generate five independent random values. Do not reuse or commit them.
# APP_KEY is generated with: php artisan key:generate
CID_LOOKUP_KEY=
PROVIDER_CID_LOOKUP_KEY=
EXTERNAL_SUBJECT_LOOKUP_KEY=
TRANSACTION_HASH_KEY=
AUDIT_HASH_KEY=

SSO_API_KEY_HEADER=X-API-Key
SSO_API_KEY_LENGTH=64
SSO_DEFAULT_PAGE_SIZE=20
SSO_MAX_PAGE_SIZE=100
SANCTUM_EXPIRATION_MINUTES=30
SANCTUM_TOKEN_PREFIX=sso_admin_

# Downstream OAuth server. Keep signing keys outside /var/www/sso-api.
PASSPORT_KEY_PATH=/etc/sobmoei/oauth
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_CONNECTION=
SSO_AUTHORIZATION_CODE_TTL_MINUTES=5
SSO_ACCESS_TOKEN_TTL_MINUTES=30
SSO_REFRESH_TOKEN_TTL_MINUTES=30
SSO_TRANSACTION_TTL_MINUTES=5

# ThaID production configuration. Insert credentials only in the server .env.
THAID_ENABLED=false
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=https://sobmoeiservice.moph.go.th/call/sso/callback/thaid
THAID_ISSUER=https://imauth.bora.dopa.go.th
THAID_AUTHORIZATION_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/auth/
THAID_TOKEN_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/token/
THAID_INTROSPECTION_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/introspect/
THAID_REVOCATION_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/revoke/
THAID_DISCOVERY_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
THAID_SCOPES="pid name openid"
THAID_CLOCK_SKEW_SECONDS=60
THAID_DISCOVERY_CACHE_SECONDS=300
THAID_JWKS_CACHE_SECONDS=300

# MOPH ID production configuration: Health ID -> Provider ID.
# Obtain the exact production base URLs from MOPH; there is no UAT fallback.
MOPH_ID_ENABLED=false
MOPH_ID_CLOCK_SKEW_SECONDS=60
HEALTH_ID_CLIENT_ID=
HEALTH_ID_CLIENT_SECRET=
HEALTH_ID_REDIRECT_URI=https://sobmoeiservice.moph.go.th/call/sso/callback/provider-id
HEALTH_ID_BASE_URL=
HEALTH_ID_AUTHORIZATION_PATH=/oauth/redirect
HEALTH_ID_TOKEN_PATH=/api/v1/token
HEALTH_ID_PUBLIC_KEY_PATH=/api/v1/oauth/public-key

PROVIDER_ID_CLIENT_ID=
PROVIDER_ID_SECRET_KEY=
PROVIDER_ID_BASE_URL=
PROVIDER_ID_TOKEN_PATH=/api/v1/services/token
PROVIDER_ID_PROFILE_PATH=/api/v1/services/profile
PROVIDER_ID_PUBLIC_KEY_PATH=/api/v1/services/public-key
PROVIDER_ID_PUBLIC_KEY_CACHE_SECONDS=300

UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_TIMEOUT_SECONDS=15
